#!/usr/bin/env bash
# Carlos' Opinion — hook de despliegue (Pavilion)
#
# Se instala en ~/carlos-opinion/repo.git/hooks/post-receive y se dispara solo
# cuando haces `git push casa main` desde tu PC.
#
# Todo ocurre dentro de casa: recibe el código, compila y publica. GitHub no
# interviene en ningún momento — allí solo se guarda copia.

set -euo pipefail

BASE="${CO_BASE:-/home/carlosalexei/carlos-opinion}"
REPO="${CO_REPO:-$BASE/repo.git}"
BUILD="$BASE/build"
SITE="$BASE/site"
BRANCH="main"

# Aviso por ntfy cuando NO se publica. Hace falta porque git ignora el código de
# salida de este hook: un push desde el PC lo enseña en pantalla, pero el timer
# del panel no tiene a nadie mirando. El ntfy de casa es deny-all: sin el token
# (CO_PANEL_NTFY_TOKEN, en panel.env) responde 403 y el aviso no llega. Un push
# desde el PC no trae entorno, así que se lee panel.env si existe.
[ -f "$BASE/panel.env" ] && . "$BASE/panel.env"
NTFY="${CO_PANEL_NTFY:-http://192.168.50.148:8090/carlos-opinion}"
NTFY_TOKEN="${CO_PANEL_NTFY_TOKEN:-}"

# Durante un hook, git deja GIT_DIR apuntando al repo bare. Si no lo quitamos,
# los comandos de git dentro de $BUILD creerían que su repo es el bare.
unset GIT_DIR GIT_WORK_TREE GIT_QUARANTINE_PATH

# Un despliegue cada vez. Sin esto, dos pushes solapados comparten el índice del
# bare en el `checkout -f` de abajo y el `dist/` que vite vacía al compilar.
# Mientras el único cliente era el PC de Carlos no pasaba; en cuanto haya un
# segundo (el panel privado, que empuja solo), pasa. El -w evita que un `npm ci`
# colgado deje el cerrojo puesto para siempre.
exec 9>"$BASE/.deploy.lock"
flock -w 900 9 || { echo "  ERROR: otro despliegue lleva 15 min bloqueado." >&2; exit 1; }

# `git` IGNORA el código de salida de post-receive: comprobado, un hook con
# `exit 1` deja el push en exit code 0 y la ref actualizada. O sea que el fallo
# es MUDO para cualquier cosa que no lea el texto del push. Estos dos ficheros
# son la forma de enterarse: scripts/deploy.mjs los compara con lo que acaba de
# empujar. No cambian el comportamiento del hook, sólo lo hacen observable.
REV_ACTUAL="(desconocida)"
log()   { echo "  $*"; }
fallo() {
  echo "  ERROR: $*" >&2
  echo "  >>> NO se ha publicado nada. La web sigue con la versión anterior."
  printf '%s\n%s\n' "$REV_ACTUAL" "$*" > "$BASE/.deploy-fail" || true
  # `|| true`: estamos bajo set -e y el aviso no puede tapar el motivo real.
  [ -n "$NTFY" ] && curl -s -m 5 -o /dev/null \
    -H "Title: Carlos' Opinion: NO se ha publicado" \
    ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
    -d "Despliegue de ${REV_ACTUAL:0:7} fallido: $*. La web sigue con la versión anterior." \
    "$NTFY" || true
  exit 1
}

while read -r _old newrev ref; do
  REV_ACTUAL="$newrev"
  [ "$ref" = "refs/heads/$BRANCH" ] || { log "Ignorando $ref (solo se publica $BRANCH)"; continue; }

  echo
  echo "=== Desplegando ${newrev:0:7} ==="

  mkdir -p "$BUILD"
  git --git-dir="$REPO" --work-tree="$BUILD" checkout -f "$BRANCH" \
    || fallo "no se pudo extraer el código"

  cd "$BUILD"

  # node_modules se conserva entre despliegues (está en .gitignore, el checkout
  # no lo toca). Solo se reinstala si cambió package-lock.json — en un dv6,
  # `npm ci` cada vez serían minutos de más por nada.
  lock_actual=$(sha256sum package-lock.json | cut -d' ' -f1)
  if [ ! -d node_modules ] || [ ! -f .lock-hash ] || [ "$(cat .lock-hash)" != "$lock_actual" ]; then
    log "Dependencias cambiadas: npm ci..."
    npm ci --no-audit --no-fund >/dev/null 2>&1 || fallo "npm ci falló"
    echo "$lock_actual" > .lock-hash
  else
    log "Dependencias sin cambios, reutilizando node_modules"
  fi

  log "Compilando..."
  npm run build >/dev/null 2>&1 || fallo "el build falló (prueba 'npm run build' en tu PC para ver el error)"

  # --- Guardas: más vale no publicar que publicar una web rota ---------------
  [ -s dist/index.html ] || fallo "el build no generó index.html"
  for f in anime manga lightnovels; do
    [ -s "dist/data/$f.json" ] || fallo "falta dist/data/$f.json"
    jq -e . "dist/data/$f.json" >/dev/null 2>&1 || fallo "data/$f.json no es JSON válido"
  done

  # --delay-updates mueve todo a su sitio al final: nadie pilla la web a medias.
  rsync -a --delete --delay-updates dist/ "$SITE/" || fallo "no se pudo copiar a $SITE"

  # Sólo aquí, con la web ya servida, se marca el despliegue como bueno.
  echo "$newrev" > "$BASE/.deploy-ok"
  rm -f "$BASE/.deploy-fail"

  echo "  Publicado. https://opinion.carlosin120fps.duckdns.org"
  echo
done
